; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LAST BASTION · 最后防线"
config/description="2D pixel side-scrolling zombie action shooter. Original art and audio, inspired by the co-op zombie survival genre."
config/version="3.1.1"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.043, 0.059, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameManager="*res://autoload/game_manager.gd"
DirectorSystem="*res://autoload/director_system.gd"
AudioManager="*res://autoload/audio_manager.gd"
SaveSystem="*res://autoload/save_system.gd"
ConfigManager="*res://autoload/config_manager.gd"
ArchiveManager="*res://scripts/archive/archive_manager.gd"
FactionManager="*res://scripts/faction/faction_manager.gd"
DialogueManager="*res://scripts/narrative/dialogue_manager.gd"
EnemyPerception="*res://scripts/ai/enemy_perception_manager.gd"
GameFeelConfig="*res://gamefeel/GameFeelConfig.gd"
InputBuffer="*res://gamefeel/input/InputBuffer.gd"
CameraPunch="*res://gamefeel/core/CameraPunch.gd"
ScreenShake="*res://gamefeel/core/ScreenShake.gd"
HitStop="*res://gamefeel/core/HitStop.gd"
AudioLayerManager="*res://gamefeel/audio/AudioLayerManager.gd"
RecoilController="*res://gamefeel/input/RecoilController.gd"
GameFeelBridge="*res://gamefeel/integration/GameFeelBridge.gd"
NetworkManager="*res://autoload/network_manager.gd"
RogueliteMapGenerator="*res://scripts/levels/roguelite_map_generator.gd"
EndlessModeManager="*res://autoload/endless_mode_manager.gd"
CinematicCamera="*res://scripts/camera/cinematic_camera.gd"
PostProcess="*res://gamefeel/integration/PostProcess.gd"

[debug]

gdscript/warnings/treat_warnings_as_errors=false

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[gamefeel]

enabled=true
reduced_motion=false

[input_devices]

pointing/emulate_mouse_from_touch=false

[input]

quick_swap={
"deadzone": 0.5,
"events": [
Object(InputEventKey,"device": -1, "key": 81, "pressed": true, "script": null)
]
}

quick_swap.joypad={
"deadzone": 0.5,
"events": []
}

[layer_names]

2d_physics/layer_1="WORLD"
2d_physics/layer_2="PLAYER"
2d_physics/layer_3="ALLY"
2d_physics/layer_4="COMMON"
2d_physics/layer_5="SPECIAL"
2d_physics/layer_6="PROJECTILE"
2d_physics/layer_7="INTERACTABLE"

[physics]

2d/default_gravity=1500.0
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.043, 0.059, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
