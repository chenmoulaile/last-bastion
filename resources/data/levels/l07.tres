events = [{"at": 0.06, "type": "dialogue", "id": "l07_branch"}, {"at": 0.14, "type": "archive", "id": "a07_01", "requires_flag": "route_drain"}, {"at": 0.14, "type": "archive", "id": "a07_01", "requires_flag": "route_gate"}, {"at": 0.16, "type": "dialogue", "id": "l07_split_tension"}, {"at": 0.2, "type": "tip", "text": "失败品：调制失败的变异体，速度快，会爬墙。优先击杀。", "requires_flag": "route_drain"}, {"at": 0.2, "type": "tip", "text": "正门突破：地平线的自动火力很猛，利用掩体推进。", "requires_flag": "route_gate"}, {"at": 0.22, "type": "weapon", "kind": "nail_gun", "text": "排水泵房工具箱：钉枪 + 一盒长钉。", "requires_flag": "route_drain"}, {"at": 0.3, "type": "humans", "faction": "horizon", "kind": "guard", "count": 5, "requires_flag": "route_gate"}, {"at": 0.34, "type": "archive", "id": "a07_02", "requires_flag": "route_drain"}, {"at": 0.34, "type": "archive", "id": "a07_02", "requires_flag": "route_gate"}, {"at": 0.35, "type": "horde", "count": 18, "alarm": false, "requires_flag": "route_drain"}, {"at": 0.35, "type": "humans", "faction": "remnants", "kind": "remnants", "count": 3, "requires_flag": "route_gate"}, {"at": 0.4, "type": "broadcast", "text": "「违抗净化者，就地净化。」扩音器的声音沿着拒马排成一线。", "requires_flag": "route_gate"}, {"at": 0.44, "type": "lore", "text": "管壁上荧光箭头标着「地平线巡检段」，下一格被人涂改过：巡检结束了，别等他们。", "requires_flag": "route_drain"}, {"at": 0.45, "type": "horde", "count": 14, "alarm": true, "requires_flag": "route_gate"}, {"at": 0.5, "type": "humans", "faction": "remnants", "kind": "remnants", "count": 2, "requires_flag": "route_gate"}, {"at": 0.5, "type": "horde", "count": 12, "alarm": false, "requires_flag": "route_drain"}, {"at": 0.52, "type": "horde", "count": 14, "alarm": false, "requires_flag": "route_gate"}, {"at": 0.54, "type": "archive", "id": "a07_03", "requires_flag": "route_drain"}, {"at": 0.54, "type": "archive", "id": "a07_03", "requires_flag": "route_gate"}, {"at": 0.55, "type": "special", "kind": "hunter", "requires_flag": "route_drain"}, {"at": 0.58, "type": "humans", "faction": "remnants", "kind": "remnants", "count": 2, "requires_flag": "help_remnants"}, {"at": 0.58, "type": "humans", "faction": "remnants", "kind": "remnants", "count": 2, "requires_flag": "chip_given"}, {"at": 0.6, "type": "humans", "faction": "horizon", "kind": "guard", "count": 5, "requires_flag": "route_gate"}, {"at": 0.64, "type": "broadcast", "text": "「泵站压力正常。注意：若听到敲管声，那不是水。」", "requires_flag": "route_drain"}, {"at": 0.68, "type": "lore", "text": "拒马铁皮标语被弹片掀掉半句：……是人类最后的防线。下面一行小字：防线不含你。", "requires_flag": "route_gate"}, {"at": 0.72, "type": "horde", "count": 16, "alarm": true, "requires_flag": "route_drain"}, {"at": 0.74, "type": "archive", "id": "a07_04", "requires_flag": "route_drain"}, {"at": 0.74, "type": "archive", "id": "a07_04", "requires_flag": "route_gate"}, {"at": 0.78, "type": "defense", "seconds": 35, "waves": 2, "count": 14, "requires_flag": "route_gate"}, {"at": 0.85, "type": "boss", "kind": "charger"}, {"at": 0.9, "type": "broadcast", "text": "「正门防线告急。重复：防线告急。请求增援——」", "requires_flag": "route_gate"}]
